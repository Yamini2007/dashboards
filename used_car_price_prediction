      "id": "a0e059d5",
      "source": [
        "## Small tuning searches — separate from the nine fixed-setting experiments\n",
        "Validation checks three training folds; tuning tries settings using those folds. Four settings per algorithm keep this small. Ridge alpha controls coefficient shrinkage; tree depth and leaf size control complexity. Tuning can help or hurt test results. These searches use preprocessing without PCA; PCA remains included in the main nine experiments."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "c955721b",
        "outputId": "305693d8-af93-45c8-8228-c69192bae0c6"
      },
      "id": "c955721b",
      "source": [
        "grids = {\n",
        "    \"Ridge Regression\": {\"model__alpha\": [.1, 1, 10, 100]},\n",
        "    \"Random Forest\": {\"model__max_depth\": [None, 15], \"model__min_samples_leaf\": [1, 2]},\n",
        "    \"Gradient Boosting\": {\"model__learning_rate\": [.03, .1], \"model__max_depth\": [2, 3]}\n",
        "}\n",
        "tuned_rows, tuning_details = [], []\n",
        "for name, grid in grids.items():\n",
        "    search = GridSearchCV(make_pipeline(algorithms[name], \"Preprocessed\"), grid,\n",
        "                         scoring=\"neg_mean_absolute_error\", cv=folds, n_jobs=1, error_score=\"raise\")\n",
        "    search.fit(X_train, y_train)\n",
        "    key = name + \" | Preprocessed + tuning\"\n",
        "    candidates[key] = search.best_estimator_\n",
        "    tuned_rows.append({\"Candidate\": key, \"Model\": name, \"Method\": \"Preprocessed + tuning\",\n",
        "                      \"CV MAE\": -search.best_score_,\n",
        "                      \"CV MAE std\": search.cv_results_[\"std_test_score\"][search.best_index_]})\n",
        "    tuning_details.append({\"Model\": name, \"Best parameters\": str(search.best_params_)})\n",
        "    print(name, search.best_params_)\n",
        "cv_results = pd.concat([cv_results, pd.DataFrame(tuned_rows)], ignore_index=True)"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Ridge Regression {'model__alpha': 0.1}\n",
            "Random Forest {'model__max_depth': None, 'model__min_samples_leaf': 1}\n",
            "Gradient Boosting {'model__learning_rate': 0.1, 'model__max_depth': 3}\n"
          ]
        }
      ],
      "execution_count": 33
    },
