      "id": "6af51bc1",
      "source": [
        "## 3. Extract original JSON-LD vehicle records\n",
        "BeautifulSoup reads structured data embedded in original HTML. Missing fields remain missing; no records are invented."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "3cb1bfec"
      },
      "id": "3cb1bfec",
      "source": [
        "def json_objects(value):\n",
        "    if isinstance(value, dict):\n",
        "        yield value\n",
        "        for child in value.values():\n",
        "            yield from json_objects(child)\n",
        "    elif isinstance(value, list):\n",
        "        for child in value:\n",
        "            yield from json_objects(child)\n",
        "\n",
        "def value_of(value, key=\"name\"):\n",
        "    return value.get(key) if isinstance(value, dict) else value\n",
        "\n",
        "def first_dict(value):\n",
        "    if isinstance(value, list):\n",
        "        return next((v for v in value if isinstance(v, dict)), {})\n",
        "    return value if isinstance(value, dict) else {}"
      ],
      "outputs": [],
      "execution_count": 5
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "a97990fc"
      },
      "id": "a97990fc",
      "source": [
        "def find_car(soup):\n",
        "    for script in soup.find_all(\"script\", type=\"application/ld+json\"):\n",
        "        try:\n",
        "            payload = json.loads(script.string or script.get_text())\n",
        "        except (ValueError, TypeError):\n",
        "            continue\n",
        "        for item in json_objects(payload):\n",
        "            types = item.get(\"@type\", [])\n",
        "            types = types if isinstance(types, list) else [types]\n",
        "            if any(str(t).rsplit(\"/\", 1)[-1] == \"Car\" for t in types):\n",
        "                return item\n",
        "    return None"
      ],
      "outputs": [],
      "execution_count": 6
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "5e8da825"
      },
      "id": "5e8da825",
      "source": [
        "# Output column → JSON-LD field. No prices or examples are fabricated.\n",
        "fields = {\"name\": \"name\", \"brand\": \"brand\", \"model\": \"model\",\n",
        "          \"owners\": \"numberOfPreviousOwners\", \"color\": \"color\",\n",
        "          \"transmission\": \"vehicleTransmission\", \"body_type\": \"bodyType\",\n",
        "          \"condition\": \"itemCondition\", \"vin\": \"vehicleIdentificationNumber\",\n",
        "          \"description\": \"description\"}\n",
        "\n",
        "def extract_car(soup, url):\n",
        "    car = find_car(soup)\n",
        "    if car is None:\n",
        "        return None\n",
        "    record = {col: value_of(car.get(field)) for col, field in fields.items()}\n",
        "    for col, field in {\"year\": \"vehicleModelDate\", \"kilometres\": \"mileageFromOdometer\",\n",
        "                       \"seating_capacity\": \"vehicleSeatingCapacity\"}.items():\n",
        "        record[col] = value_of(car.get(field), \"value\")\n",
        "    offers = first_dict(car.get(\"offers\"))\n",
        "    record.update(price=offers.get(\"price\"), price_currency=offers.get(\"priceCurrency\"),\n",
        "                  fuel_type=first_dict(car.get(\"vehicleEngine\")).get(\"fuelType\"), url=url)\n",
        "    return record"
      ],
      "outputs": [],
      "execution_count": 7
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "a39bbb12"
      },
      "id": "a39bbb12",
      "source": [
        "## 4. Live collection — retained directly in memory"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "45832eaa"
      },
      "id": "45832eaa",
      "source": [
        "def collect_live():\n",
        "    links = collect_links()\n",
        "    collected = []\n",
        "    try:\n",
        "        for i, url in enumerate(links, 1):\n",
        "            soup = fetch_page(url)\n",
        "            record = extract_car(soup, url) if soup is not None else None\n",
        "            if record is not None:\n",
        "                collected.append(record)\n",
        "            if i % 25 == 0:\n",
        "                print(f\"Checked {i}; collected {len(collected)}\")\n",
        "            if len(collected) >= TARGET_RECORDS:\n",
        "                break\n",
        "    except CollectionBlocked:\n",
        "        # Keep partial evidence in memory without silently claiming completion.\n",
        "        globals()[\"partial_cars_data\"] = collected\n",
        "        raise\n",
        "    return collected"
      ],
      "outputs": [],
      "execution_count": 8
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "5b372fd1"
      },
      "id": "5b372fd1",
      "source": [
        "## 5. Optional original HTML input\n",
        "Skip this code automatically in live/memory mode. ZIP contents are read in memory, not extracted to disk. Save vehicle **detail pages**, not a screenshot or PDF. Some browser-saved pages omit the structured data; the count below reveals whether extraction succeeded."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "9614ac24"
      },
      "id": "9614ac24",
      "source": [
        "def read_saved_pages():\n",
        "    pages = []\n",
        "    if \"google.colab\" in sys.modules:\n",
        "        from google.colab import files\n",
        "        uploaded = files.upload()\n",
        "        pages = list(uploaded.items())\n",
        "    else:\n",
        "        pages = [(str(p), p.read_bytes()) for p in Path(HTML_FOLDER).rglob(\"*.htm*\")]\n",
        "        if HTML_ZIP:\n",
        "            pages.append((HTML_ZIP, Path(HTML_ZIP).read_bytes()))\n",
        "    expanded = []\n",
        "    import io\n",
        "    for name, content in pages:\n",
        "        if name.lower().endswith(\".zip\"):\n",
        "            with zipfile.ZipFile(io.BytesIO(content)) as archive:\n",
        "                for member in archive.namelist():\n",
        "                    if member.lower().endswith((\".html\", \".htm\")):\n",
        "                        expanded.append((member, archive.read(member)))\n",
        "        elif name.lower().endswith((\".html\", \".htm\")):\n",
        "            expanded.append((name, content))\n",
        "    return expanded"
      ],
      "outputs": [],
      "execution_count": 9
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "4fb03f94"
      },
      "id": "4fb03f94",
      "source": [
        "def collect_saved_html():\n",
        "    collected = []\n",
        "    for filename, content in read_saved_pages():\n",
        "        soup = BeautifulSoup(content, \"html.parser\")\n",
        "        car = find_car(soup)\n",
        "        if car is None:\n",
        "            print(\"No vehicle JSON-LD:\", filename)\n",
        "            continue\n",
        "        canonical = soup.find(\"link\", rel=\"canonical\")\n",
        "        url = car.get(\"url\") or (canonical.get(\"href\") if canonical else None) or filename\n",
        "        record = extract_car(soup, str(url))\n",
        "        if record is not None:\n",
        "            record[\"source_file\"] = filename\n",
        "            collected.append(record)\n",
        "    return collected"
      ],
      "outputs": [],
      "execution_count": 10
    },
