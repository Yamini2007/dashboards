      },
      "id": "d8145f18",
      "source": [
        "## 14. Validate all nine combinations\n",
        "Three-fold cross-validation uses training cars only. Lower mean validation MAE is better; the standard deviation describes variation across folds.\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 331
        },
        "id": "c4b5241b",
        "outputId": "059e4ec1-5fd3-434c-ca3f-1521e9abb469"
      },
      "id": "c4b5241b",
      "source": [
        "folds = KFold(n_splits=3, shuffle=True, random_state=42)\n",
        "methods = [\"Raw\", \"Preprocessed\", \"Preprocessed + PCA\"]\n",
        "candidates, cv_rows = {}, []\n",
        "for name, algorithm in algorithms.items():\n",
        "    for method in methods:\n",
        "        pipeline = make_pipeline(algorithm, method)\n",
        "        scores = -cross_val_score(pipeline, X_train, y_train,\n",
        "            scoring=\"neg_mean_absolute_error\", cv=folds, n_jobs=1, error_score=\"raise\")\n",
        "        key = name + \" | \" + method\n",
        "        candidates[key] = pipeline\n",
        "        cv_rows.append({\"Candidate\": key, \"Model\": name, \"Method\": method,\n",
        "                        \"CV MAE\": scores.mean(), \"CV MAE std\": scores.std()})\n",
        "cv_results = pd.DataFrame(cv_rows)\n",
        "display(cv_results.sort_values(\"CV MAE\").round(2))\n"
