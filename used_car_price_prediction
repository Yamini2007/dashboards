      "id": "583ea311",
      "source": [
        "audit_values = clone(clean_transform).fit_transform(clean_train)\n",
        "print(\"Missing entries after imputation:\", np.isnan(audit_values).sum())\n",
        "assert np.isfinite(audit_values).all()"
