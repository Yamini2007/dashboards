      "source": [
        "## 2. Collection settings\n",
        "First try `live`. If it returns HTTP 403, choose `html`: open original vehicle listings in your regular browser, use Save page as HTML, then upload those HTML files or a ZIP containing them. Repeated pages do not count as new cars. Aim to retain your original 1,000+ records; a handful of saved pages is not a substitute for that dataset."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "b574f445"
      },
      "id": "b574f445",
      "source": [
        "DATA_MODE = \"live\"       # \"live\", \"html\", or \"memory\"\n",
        "LISTING_URL = \"https://www.cardekho.com/used-cars+in+pune\"\n",
        "MAX_PAGES = 70\n",
        "TARGET_RECORDS = 1200\n",
        "REFERENCE_YEAR = 2026\n",
        "HTML_FOLDER = \"saved_car_pages\"   # For local Jupyter HTML mode\n",
        "HTML_ZIP = \"\"                      # Optional local ZIP path\n",
        "collection_log = []"
      ],
      "outputs": [],
      "execution_count": 2
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "f8c93fad"
      },
      "id": "f8c93fad",
      "source": [
        "import json, time, zipfile\n",
        "from pathlib import Path\n",
        "from urllib.parse import urljoin, urlsplit, urlunsplit\n",
        "import requests\n",
        "import pandas as pd\n",
        "from bs4 import BeautifulSoup\n",
        "\n",
        "class CollectionBlocked(RuntimeError):\n",
        "    pass\n",
        "\n",
        "def fetch_page(url):\n",
        "    try:\n",
        "        response = requests.get(url, headers={\"User-Agent\": \"Mozilla/5.0\"}, timeout=25)\n",
        "        collection_log.append({\"url\": url, \"http_status\": response.status_code})\n",
        "        if response.status_code in (401, 403, 429):\n",
        "            raise CollectionBlocked(f\"Source refused HTTP {response.status_code}. No further requests made.\")\n",
        "        response.raise_for_status()\n",
        "        return BeautifulSoup(response.text, \"html.parser\")\n",
        "    except requests.RequestException as error:\n",
        "        collection_log.append({\"url\": url, \"error\": str(error)})\n",
        "        return None\n",
        "    finally:\n",
        "        time.sleep(0.5)"
      ],
      "outputs": [],
      "execution_count": 3
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "2fa3bacc"
      },
      "id": "2fa3bacc",
      "source": [
        "def collect_links():\n",
        "    links, seen = [], set()\n",
        "    empty_pages = 0\n",
        "    for page in range(1, MAX_PAGES + 1):\n",
        "        url = LISTING_URL if page == 1 else f\"{LISTING_URL}/page-{page}\"\n",
        "        soup = fetch_page(url)\n",
        "        if soup is None:\n",
        "            continue\n",
        "        added = 0\n",
        "        for anchor in soup.select(\"a[href]\"):\n",
        "            href = anchor.get(\"href\", \"\")\n",
        "            if \"/used-car-details/\" not in href:\n",
        "                continue\n",
        "            parts = urlsplit(urljoin(LISTING_URL, href))\n",
        "            if parts.hostname not in (\"www.cardekho.com\", \"cardekho.com\"):\n",
        "                continue\n",
        "            link = urlunsplit((parts.scheme, parts.netloc, parts.path, \"\", \"\"))\n",
        "            if link not in seen:\n",
        "                links.append(link)\n",
        "                seen.add(link)\n",
        "                added += 1\n",
        "        print(f\"Page {page}: {added} new links; {len(links)} total\")\n",
        "        empty_pages = empty_pages + 1 if added == 0 else 0\n",
        "        if empty_pages >= 3:\n",
        "            break\n",
        "    return links\n"
      ],
      "outputs": [],
      "execution_count": 4
    },
