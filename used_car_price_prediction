      "id": "03c33b0d",
      "source": [
        "## 1. Install missing packages once\n",
        "This cell installs only missing packages; it does not upgrade existing ones. If an old scikit-learn rejects `sparse_output` or `keep_empty_features`, upgrade scikit-learn and restart the runtime."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "35319c38",
        "outputId": "29b3c281-7c46-43b5-cc10-691a499ee019"
      },
      "id": "35319c38",
      "source": [
        "import importlib.util, subprocess, sys\n",
        "packages = {\"requests\": \"requests\", \"bs4\": \"beautifulsoup4\", \"numpy\": \"numpy\",\n",
        "            \"pandas\": \"pandas\", \"matplotlib\": \"matplotlib\", \"sklearn\": \"scikit-learn\"}\n",
        "missing = [package for module, package in packages.items()\n",
        "           if importlib.util.find_spec(module) is None]\n",
        "if missing:\n",
        "    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", *missing])\n",
        "print(\"Packages ready\")"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Packages ready\n"
          ]
        }
      ],
